{
  "manifest_version": 3,
  "name": "regitlab",
  "version": "0.2.8",
  "description": "gitlab分支快速选择、创建pull Request自动化、一键生成日志",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://devops.cscec.com/*",
    "https://dcs-uat-gray.cscec.com/*",
    "https://dcs-uat.cscec.com/*",
    "https://dcs-pre.cscec.com/*",
    "https://dcs.cscec.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "gitLab协同工作",
    "default_icon": "icons/icon-16.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://devops.cscec.com/*"
      ],
      "js": ["config-bridge.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://dcs-uat-gray.cscec.com/*",
        "https://dcs-uat.cscec.com/*",
        "https://dcs-pre.cscec.com/*",
        "https://dcs.cscec.com/*"
      ],
      "js": ["dcs-menu-search-focus.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["replacement/*", "config-injector.js"],
      "matches": [
        "https://devops.cscec.com/*",
        "https://dcs-uat-gray.cscec.com/*",
        "https://dcs-uat.cscec.com/*",
        "https://dcs-pre.cscec.com/*",
        "https://dcs.cscec.com/*"
      ]
    }
  ]
}
